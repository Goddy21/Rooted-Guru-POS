<PrinterConfigForm>:
    orientation: "vertical"
    size_hint: 1, 1
    padding: [40, 30]
    spacing: 0

    canvas.before:
        Color:
            rgba: (0.93, 0.95, 0.97, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    # ── Header ──────────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: 60
        padding: [0, 10, 0, 0]

        Label:
            text: "Printer Configuration"
            font_size: '22sp'
            bold: True
            color: 0.1, 0.1, 0.1, 1
            halign: 'center'
            valign: 'middle'
            text_size: self.size

    # ── Divider ──────────────────────────────────────────
    BoxLayout:
        size_hint_y: None
        height: 2
        canvas.before:
            Color:
                rgba: 0.16, 0.4, 0.64, 1
            Rectangle:
                pos: self.pos
                size: self.size

    Widget:
        size_hint_y: None
        height: 24

    # ── Card ─────────────────────────────────────────────
    BoxLayout:
        orientation: 'vertical'
        size_hint: None, None
        width: min(self.parent.width * 0.88, 560)
        height: self.minimum_height
        pos_hint: {"center_x": 0.5}
        padding: [28, 24]
        spacing: 16

        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10]
            Color:
                rgba: 0.82, 0.87, 0.92, 1
            Line:
                rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
                width: 1.2

        # ── Fields ───────────────────────────────────────
        GridLayout:
            cols: 2
            spacing: [16, 14]
            row_default_height: 42
            row_force_default: True
            size_hint_y: None
            height: self.minimum_height
            size_hint_x: 1

            Label:
                text: "Vendor ID:"
                font_size: '15sp'
                halign: "right"
                valign: "middle"
                text_size: self.size
                color: 0.25, 0.25, 0.25, 1
                size_hint_x: 0.35

            TextInput:
                id: vendor_id
                hint_text: "e.g. 0x04b8"
                font_size: '15sp'
                multiline: False
                size_hint_x: 0.65
                padding: [10, 10]

            Label:
                text: "Product ID:"
                font_size: '15sp'
                halign: "right"
                valign: "middle"
                text_size: self.size
                color: 0.25, 0.25, 0.25, 1
                size_hint_x: 0.35

            TextInput:
                id: product_id
                hint_text: "e.g. 0x0202"
                font_size: '15sp'
                multiline: False
                size_hint_x: 0.65
                padding: [10, 10]

            Label:
                text: "Interface:"
                font_size: '15sp'
                halign: "right"
                valign: "middle"
                text_size: self.size
                color: 0.25, 0.25, 0.25, 1
                size_hint_x: 0.35

            TextInput:
                id: interface
                hint_text: "optional"
                font_size: '15sp'
                multiline: False
                size_hint_x: 0.65
                padding: [10, 10]

            Label:
                text: "Timeout:"
                font_size: '15sp'
                halign: "right"
                valign: "middle"
                text_size: self.size
                color: 0.25, 0.25, 0.25, 1
                size_hint_x: 0.35

            TextInput:
                id: timeout
                hint_text: "optional"
                font_size: '15sp'
                multiline: False
                size_hint_x: 0.65
                padding: [10, 10]

            Label:
                text: "Encoding:"
                font_size: '15sp'
                halign: "right"
                valign: "middle"
                text_size: self.size
                color: 0.25, 0.25, 0.25, 1
                size_hint_x: 0.35

            TextInput:
                id: encoding
                hint_text: "e.g. utf-8"
                font_size: '15sp'
                multiline: False
                size_hint_x: 0.65
                padding: [10, 10]

        Widget:
            size_hint_y: None
            height: 10

        # ── Save Button ───────────────────────────────────
        Button:
            text: "Save Printer Settings"
            font_size: '16sp'
            size_hint_y: None
            height: 48
            background_normal: ''
            background_color: (0.16, 0.4, 0.64, 1)
            color: 1, 1, 1, 1
            on_release: root.save_config()

    Widget:
        size_hint_y: 1