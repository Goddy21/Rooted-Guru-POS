<FlatButton@ButtonBehavior+Label>:
    font_size: 14
    color: (1, 1, 1, 1)
    text_size: self.size
    halign: 'center'
    valign: 'middle'

<OperationWindow>:
    id: main_win
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: (0.93, 0.95, 0.98, 1)
        Rectangle:
            size: self.size
            pos: self.pos

    # Header Section
    BoxLayout:
        id: header
        size_hint_y: None
        height: 44
        canvas.before:
            Color:
                rgba: (0.10, 0.31, 0.55, 1)
            Rectangle:
                size: self.size
                pos: self.pos

        Image:
            id: op_logo
            source: ''
            size_hint_x: None
            width: 36
            fit_mode: 'contain'

        Label:
            text: 'Point Of Sale System'
            size_hint_x: .85
            bold: True
            color: (1, 1, 1, 1)
            font_size: '18sp'

        FlatButton:
            id: loggedin_user
            text: 'root'
            font_size: '15sp'
            color: (0.75, 0.88, 1.0, 1)
            underline: True
            size_hint_x: None
            width: 100
            on_release: root.logout()

    # Current Item Section
    BoxLayout:
        id: current
        size_hint_y: None
        height: 48
        canvas.before:
            Color:
                rgba: (0.14, 0.42, 0.72, 1)
            Rectangle:
                size: self.size
                pos: self.pos

        Button:
            text: 'Current Item'
            background_normal: ''
            background_color: (0.16, 0.45, 0.74, 1)
            size_hint_x: .25
            font_size: '14sp'
            bold: True
            color: (0.85, 0.92, 1.0, 1)

        Button:
            id: cur_product
            text: 'Default Product'
            background_normal: ''
            background_color: (0.18, 0.50, 0.82, 1)
            font_size: '15sp'
            bold: True
            color: (1, 1, 1, 1)

        Button:
            id: cur_price
            text: 'KES 0.00'
            background_normal: ''
            background_color: (0.08, 0.36, 0.64, 1)
            size_hint_x: .22
            font_size: '15sp'
            bold: True
            color: (0.80, 1.0, 0.85, 1)

    # Product Details Section
    BoxLayout:
        padding: [8, 6]
        spacing: 6

        BoxLayout:
            id: product_details
            orientation: 'vertical'
            size_hint_x: .72
            spacing: 6

            # Column Headers
            BoxLayout:
                id: product_labels
                size_hint_y: None
                height: 38
                canvas.before:
                    Color:
                        rgba: (0.16, 0.45, 0.74, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [6, 6, 0, 0]
                FlatButton:
                    text: 'Qty'
                    size_hint_x: .1
                    font_size: '14sp'
                FlatButton:
                    text: 'Product Code'
                    size_hint_x: .3
                    font_size: '14sp'
                FlatButton:
                    text: 'Disc'
                    size_hint_x: .1
                    font_size: '14sp'
                FlatButton:
                    text: 'Disc %'
                    size_hint_x: .1
                    font_size: '14sp'
                FlatButton:
                    text: 'VAT'
                    size_hint_x: .1
                    font_size: '14sp'
                FlatButton:
                    text: 'Price'
                    size_hint_x: .1
                    font_size: '14sp'
                FlatButton:
                    text: 'Total'
                    size_hint_x: .2
                    font_size: '14sp'

            # Input Row — NO canvas overrides on TextInputs so text stays visible
            BoxLayout:
                id: product_inputs
                size_hint_y: None
                height: 42
                spacing: 4
                padding: [4, 2]
                canvas.before:
                    Color:
                        rgba: (1, 1, 1, 1)
                    Rectangle:
                        pos: self.pos
                        size: self.size

                TextInput:
                    id: qty_inp
                    size_hint_x: .1
                    text: '1'
                    font_size: '15sp'
                    padding: [6, 8]
                    background_color: (0.97, 0.98, 1.0, 1)
                    foreground_color: (0.10, 0.15, 0.25, 1)
                    cursor_color: (0.10, 0.31, 0.55, 1)

                TextInput:
                    id: code_inp
                    size_hint_x: .3
                    multiline: False
                    on_text_validate: root.update_purchases()
                    focus: True
                    font_size: '15sp'
                    padding: [6, 8]
                    background_color: (0.97, 0.98, 1.0, 1)
                    foreground_color: (0.10, 0.15, 0.25, 1)
                    cursor_color: (0.10, 0.31, 0.55, 1)

                TextInput:
                    id: disc_inp
                    size_hint_x: .1
                    text: '0.00'
                    font_size: '15sp'
                    padding: [6, 8]
                    background_color: (0.97, 0.98, 1.0, 1)
                    foreground_color: (0.10, 0.15, 0.25, 1)
                    cursor_color: (0.10, 0.31, 0.55, 1)

                TextInput:
                    id: disc_perc_inp
                    size_hint_x: .1
                    text: '0'
                    font_size: '15sp'
                    padding: [6, 8]
                    background_color: (0.97, 0.98, 1.0, 1)
                    foreground_color: (0.10, 0.15, 0.25, 1)
                    cursor_color: (0.10, 0.31, 0.55, 1)

                TextInput:
                    id: vat_inp
                    size_hint_x: .1
                    text: '15%'
                    font_size: '15sp'
                    padding: [6, 8]
                    background_color: (0.97, 0.98, 1.0, 1)
                    foreground_color: (0.10, 0.15, 0.25, 1)
                    cursor_color: (0.10, 0.31, 0.55, 1)

                TextInput:
                    id: price_inp
                    size_hint_x: .1
                    text: '0.00'
                    font_size: '15sp'
                    padding: [6, 8]
                    background_color: (0.97, 0.98, 1.0, 1)
                    foreground_color: (0.10, 0.15, 0.25, 1)
                    cursor_color: (0.10, 0.31, 0.55, 1)

                TextInput:
                    id: total_inp
                    size_hint_x: .2
                    text: '0.00'
                    font_size: '15sp'
                    padding: [6, 8]
                    background_color: (0.97, 0.98, 1.0, 1)
                    foreground_color: (0.10, 0.15, 0.25, 1)
                    cursor_color: (0.10, 0.31, 0.55, 1)

            # Cart Section
            BoxLayout:
                id: add_to_cart
                orientation: 'vertical'

                # Cart Column Headers
                BoxLayout:
                    size_hint_y: None
                    height: 32
                    canvas.before:
                        Color:
                            rgba: (0.14, 0.42, 0.72, 1)
                        Rectangle:
                            size: self.size
                            pos: self.pos
                    Label:
                        text: 'Code'
                        size_hint_x: .2
                        color: (1, 1, 1, 1)
                        font_size: '13sp'
                        bold: True
                    Label:
                        text: 'Product Name'
                        size_hint_x: .3
                        color: (1, 1, 1, 1)
                        font_size: '13sp'
                        bold: True
                    Label:
                        text: 'Qty'
                        size_hint_x: .1
                        color: (1, 1, 1, 1)
                        font_size: '13sp'
                        bold: True
                    Label:
                        text: 'Disc'
                        size_hint_x: .1
                        color: (1, 1, 1, 1)
                        font_size: '13sp'
                        bold: True
                    Label:
                        text: 'Price'
                        size_hint_x: .1
                        color: (1, 1, 1, 1)
                        font_size: '13sp'
                        bold: True
                    Label:
                        text: 'Total'
                        size_hint_x: .2
                        color: (1, 1, 1, 1)
                        font_size: '13sp'
                        bold: True

                # Scroll View for Products
                ScrollView:
                    canvas.before:
                        Color:
                            rgba: (1, 1, 1, 1)
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    GridLayout:
                        id: products
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height

        # Receipt Preview Panel
        BoxLayout:
            id: preview
            orientation: 'vertical'
            size_hint_x: .28
            padding: [8, 6]
            spacing: 6
            canvas.before:
                Color:
                    rgba: (1, 1, 1, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [8, 8, 8, 8]
                Color:
                    rgba: (0.82, 0.87, 0.93, 1)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, 8)
                    width: 1

            Label:
                text: 'Receipt Preview'
                size_hint_y: None
                height: 26
                font_size: '13sp'
                bold: True
                color: (0.10, 0.31, 0.55, 1)
                halign: 'center'
                text_size: self.size
                valign: 'middle'

            TextInput:
                id: receipt_preview
                readonly: True
                text: 'Rooted Guru'
                bold: True
                halign: "center"
                font_name: 'RobotoMono-Regular'
                valign: "top"
                padding: [8, 8]
                font_size: '14sp'
                background_color: (0.98, 0.99, 1.0, 1)
                foreground_color: (0.10, 0.15, 0.25, 1)

    # Payment and Transaction Section
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: 70
        padding: [10, 8]
        spacing: 16
        canvas.before:
            Color:
                rgba: (0.95, 0.97, 1.0, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: .38
            spacing: 4

            Label:
                text: 'Payment Method'
                font_size: '13sp'
                size_hint_y: None
                height: 18
                color: (0.35, 0.42, 0.52, 1)
                halign: 'left'
                text_size: self.size
                valign: 'middle'

            Spinner:
                id: payment_spinner
                text: 'Select Payment Method'
                values: ['Cash', 'Credit Card', 'Mobile Payment']
                size_hint_y: None
                height: 40
                background_normal: ''
                background_color: (0.10, 0.38, 0.68, 1)
                color: (1, 1, 1, 1)
                font_size: '15sp'
                on_text: root.select_payment_method(self.text)

        BoxLayout:
            orientation: 'horizontal'
            spacing: 10
            size_hint_x: .62

            Button:
                text: 'Complete Transaction'
                background_normal: ''
                background_color: (0.07, 0.48, 0.24, 1)
                color: (1, 1, 1, 1)
                font_size: '15sp'
                bold: True
                on_release: root.complete_transaction()

            Button:
                text: 'Print Receipt'
                background_normal: ''
                background_color: (0.10, 0.38, 0.68, 1)
                color: (1, 1, 1, 1)
                font_size: '15sp'
                bold: True
                on_release: root.print_receipt()

    # Footer Section
    BoxLayout:
        id: footer
        size_hint_y: None
        height: 32
        canvas.before:
            Color:
                rgba: (0.10, 0.31, 0.55, 1)
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: 'Software by Rooted Guru Company Limited'
            color: (0.85, 0.90, 1.0, 1)
            font_size: '13sp'
            halign: 'center'
            text_size: self.size
            valign: 'middle'

        Button:
            text: 'Printer Settings'
            size_hint_x: None
            width: 160
            font_size: '13sp'
            bold: True
            background_normal: ''
            background_color: (0.10, 0.55, 0.80, 1)
            color: (1, 1, 1, 1)
            on_release: root.open_printer_settings()
